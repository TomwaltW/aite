# 并行开发的 worktree（挂在主仓工作区里，不入库）。
# 必须 ignore：否则主仓根上跑的任何全树命令（cargo fmt --check、gofmt -l .、
# grep 类自检）都会连各轨的代码一起扫。
/.worktrees/

# 运行期数据（StorageConfig 的默认落盘位置）
/data/

# 本地实配（含真实取值；仓库里只留 config/aite.example.yaml）
config/aite.yaml

# 系统
.DS_Store

# Rust / Go 构建产物（2026-09-11 重写起）
/core/target/
/edge/bin/
# core ↔ edge 的 unix socket
/data/run/
