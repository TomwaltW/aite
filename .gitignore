# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/

# 虚拟环境
.venv/
venv/

# 并行开发的 worktree（挂在主仓工作区里，不入库）。
# 必须 ignore：否则主仓的 `ruff check .` 会连各轨的代码一起扫，A4 直接废。
/.worktrees/

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 运行期数据（StorageConfig 的默认落盘位置）
/data/

# 本地实配（含真实取值；仓库里只留 config/aite.example.yaml）
config/aite.yaml

# 系统
.DS_Store
